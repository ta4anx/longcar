<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.22"/>
  <requires lib="Adw" version="1.9"/>
  <object class="GtkBox" id="doctor_page">
    <property name="orientation">vertical</property>
    <property name="spacing">12</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">12</property>
        <child>
          <object class="GtkLabel">
            <property name="label">Environment checks</property>
            <property name="xalign">0</property>
            <property name="hexpand">true</property>
            <property name="css-classes">heading</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="refresh_doctor_button">
            <property name="label">Refresh</property>
            <property name="tooltip-text">Run all environment checks again</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="copy_doctor_button">
            <property name="label">Copy diagnostics</property>
            <property name="tooltip-text">Copy the doctor JSON with secrets redacted</property>
            <property name="valign">center</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="doctor_detail">
        <property name="label">Run the checks to see the workstation status</property>
        <property name="xalign">0</property>
        <property name="wrap">true</property>
        <property name="selectable">true</property>
        <property name="css-classes">dim-label</property>
      </object>
    </child>
    <child>
      <object class="GtkListBox" id="doctor_checks">
        <property name="selection-mode">none</property>
        <property name="css-classes">boxed-list</property>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Self-test</property>
        <property name="description">Creates and removes a temporary virtual monitor without touching screens or Sunshine</property>
        <child>
          <object class="AdwActionRow">
            <property name="title">Run display self-test</property>
            <property name="subtitle">Create and remove a temporary 1366x768 virtual monitor</property>
            <child type="suffix">
              <object class="GtkButton" id="display_test_button">
                <property name="label">Run test</property>
                <property name="tooltip-text">Create a temporary virtual display</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
